{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/talk-check.mjs start",
            "timeout": 10,
            "statusMessage": "Loading the talk record"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/talk-check.mjs stop",
            "timeout": 10,
            "statusMessage": "Checking for talk material"
          }
        ]
      }
    ]
  }
}
